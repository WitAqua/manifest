<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="witaqua"
           fetch="https://github.com/WitAqua/"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/16.0" />

  <remote  name="witaqua-devices"
           fetch="https://github.com/WitAqua-Devices/"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/16.0" />

  <remote  name="gitlab"
           fetch="https://gitlab.com/"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/16.0" />

  <!-- WitAqua additions -->
  <project path="manifest" name="manifest" remote="witaqua" />

  <!-- Art -->
  <project path="art" name="art" groups="pdk" remote="witaqua" />

  <!-- Bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="witaqua" />

  <!-- Bootable -->
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="witaqua" />

  <!-- Build -->
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="witaqua" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="build/soong" name="build_soong" groups="pdk,tradefed,sysui-studio" remote="witaqua" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Sepolicy -->
  <project path="device/lineage/sepolicy" name="device_witaqua_sepolicy" remote="witaqua" />

  <!-- External -->
  <project path="external/bouncycastle" name="external_bouncycastle" groups="pdk" remote="witaqua" />
  <project path="external/FadingEdgeLayout" name="external_FadingEdgeLayout" remote="witaqua" />
  <project path="external/robolectric" name="external_robolectric" groups="pdk" remote="witaqua" />

  <!-- Frameworks -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk,sysui-studio" remote="witaqua" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="witaqua" />
  <project path="frameworks/libs/systemui" name="frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="witaqua" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="witaqua" />
  <project path="frameworks/opt/telephony" name="frameworks_opt_telephony" groups="pdk,sysui-studio" remote="witaqua" />

  <!-- LineageOS additions -->
  <project path="lineage-sdk" name="lineage-sdk" remote="witaqua" />

  <!-- Packages -->
  <project path="packages/apps/Dialer" name="packages_apps_Dialer" groups="pdk-fs" remote="witaqua" />
  <project path="packages/apps/FaceUnlock" name="WitAqua/packages_apps_FaceUnlock" remote="gitlab" />
  <project path="packages/apps/GameSpace" name="packages_apps_GameSpace" remote="witaqua" />
  <project path="packages/apps/LineageParts" name="packages_apps_LineageParts" remote="witaqua" />
  <project path="packages/apps/LMOFreeform" name="packages_apps_LMOFreeform" remote="witaqua" />
  <project path="packages/apps/OmniStyle" name="packages_apps_OmniStyle" remote="witaqua" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" remote="witaqua" />
  <project path="packages/apps/SetupWizard" name="packages_apps_SetupWizard" remote="witaqua" />
  <project path="packages/apps/ThemePicker" name="packages_apps_ThemePicker" groups="pdk-fs,sysui-studio" remote="witaqua" />
  <project path="packages/apps/Updater" name="packages_apps_Updater" remote="witaqua" />
  <project path="packages/apps/WitAquaLauncher" name="packages_apps_WitAquaLauncher" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="witaqua" />
  <project path="packages/apps/WitAquaMagic" name="packages_apps_WitAquaMagic" remote="witaqua" />
  <project path="packages/services/OmniJaws" name="packages_services_OmniJaws" remote="witaqua" />

  <!-- System -->
  <project path="system/core" name="system_core" groups="pdk" remote="witaqua" />

  <!-- Vendor -->
  <project path="vendor/lineage" name="vendor_witaqua" remote="witaqua" />
  <project path="vendor/addons" name="vendor_addons" remote="witaqua" />
</manifest>